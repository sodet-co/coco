# Copia este archivo como .env.local.
# La base vive en InsForge: la cadena sale con `npx @insforge/cli db connection-string`
# (o en el panel: Project Settings → Connect → Connection String). Es secreta: solo servidor.
DATABASE_URL=postgresql://postgres:CLAVE@APPKEY.us-east.database.insforge.app:5432/insforge?sslmode=verify-full

# Inicio de sesión con InsForge (middleware.js). Son públicas: la anon key sale con
# `npx @insforge/cli secrets get ANON_KEY`. Sin ellas el sitio responde 503.
NEXT_PUBLIC_INSFORGE_URL=https://APPKEY.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_...
